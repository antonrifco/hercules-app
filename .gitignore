# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Android / Gradle / IDE
.gradle/
build/
local.properties
.idea/
*.iml
.DS_Store
.kotlin/
captures/
*.apk
*.aab
.lavish/

# The Gradle wrapper must be committed (overrides *.jar above)
!gradle/wrapper/gradle-wrapper.jar

# Xcode (the project is generated from apple/project.yml with XcodeGen)
apple/*.xcodeproj/
apple/*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate
