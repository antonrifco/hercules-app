<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name=".HerculesMobileApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Hercules">

        <!-- The watch delivers its own reminders while it is worn; the phone must not mirror them. -->
        <meta-data android:name="com.google.android.wearable.notificationBridgeMode" android:value="NO_BRIDGING" />

        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.Hercules.Starting"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Continue on phone" from the watch: hercules://open?target=EVENT&event=ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hercules" android:host="open" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.CheckInListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hercules/checkin" />
            </intent-filter>
        </service>

        <!-- Receives sync batches from the watch (MessageClient.sendRequest). Bound only by
             Google Play services; only apps signed with our key + same applicationId can reach it. -->
        <service
            android:name=".sync.WatchSyncListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hercules" />
            </intent-filter>
        </service>
    </application>
</manifest>
